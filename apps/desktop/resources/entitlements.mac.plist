<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Hardened-runtime entitlements for the TYSA app and its helpers. Without
	audio-input, macOS refuses the microphone (dictation) without ever asking.
	disable-library-validation lets an ad-hoc signed build load Electron's
	frameworks and the native modules (canvas, resvg).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
